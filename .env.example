# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Gemini model ID and per-user daily call cap for /api/ai/suggest
GEMINI_MODEL="gemini-3.8-flash"
AI_DAILY_LIMIT="40"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================================
# Single-User Owner Access Control (Abhishek's 3 Gmail accounts)
# ============================================================================
ALLOWED_EMAILS="abhishekbhardwaj7763@gmail.com,abhigt6t@gmail.com,akbhardwaj7027@gmail.com"
MASTER_AUTH_PASS="Abhi@7763"
MASTER_PIN="702711"
MASTER_AUTH_SECRET="abhi-702711-master-secret-goalos"

# ============================================================================
# Supabase PostgreSQL Cloud Sync (Recommended for Vercel & PWA)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ============================================================================
# Cloud SQL / PostgreSQL + Vercel Database Configuration
# ============================================================================
# SQL_CONNECTION_MODE:
#   - "connector" (Recommended for Vercel -> Google Cloud SQL over TLS 1.3 IAM connector)
#   - "direct"    (For Supabase Postgres, local development, Cloud SQL Auth Proxy, or Cloud Run unix socket)
SQL_CONNECTION_MODE="direct"

# Serverless connection pool cap per instance (1 or 2 recommended for Vercel)
SQL_POOL_MAX="2"

# Required when SQL_CONNECTION_MODE="connector"
# Format: "project-id:region:instance-name"
CLOUD_SQL_INSTANCE_CONNECTION_NAME=""
# Optional IP type for Connector: "PUBLIC" (default), "PRIVATE", or "PSC"
CLOUD_SQL_IP_TYPE="PUBLIC"
# Optional Auth type for Connector: "PASSWORD" (default) or "IAM"
CLOUD_SQL_AUTH_TYPE="PASSWORD"
# Service Account JSON string with "Cloud SQL Client" role (store in Vercel Env Vars, never commit)
GOOGLE_APPLICATION_CREDENTIALS_JSON=""

# Database Credentials & Direct Host Settings
SQL_HOST="/cloudsql/instance"
SQL_PORT="5432"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD=""
SQL_SSL="false"
SQL_SSL_REJECT_UNAUTHORIZED="true"

# Admin credentials for running Drizzle schema migrations (drizzle-kit push / migrate)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""

# ============================================================================
# Security & Web Push Reminder Engine Secrets (Must be strong 40+ char secrets)
# ============================================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:abhishekbhardwaj7763@gmail.com"
CRON_SECRET=""
DONE_LINK_SECRET=""

# ============================================================================
# Safe Incremental Sync Feature Flags (Kept for 1 release)
# ============================================================================
# Server-side: allow legacy POST /api/state { action: 'sync' } fallback ("true" default, set "false" to disable)
LEGACY_FULL_STATE_SYNC="true"
# Client-side: set to "true" only to revert client from POST /api/mutate back to legacy full-state POST /api/state
NEXT_PUBLIC_LEGACY_FULL_STATE_SYNC="false"

